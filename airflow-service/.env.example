HostConsul=consul:8500
KeyConsul=airflow-service/config
ServiceConsul=airflow-service

# .env only bootstraps the Consul connection above. The actual runtime config
# (including AirflowConfig.Host) lives in Consul KV at KeyConsul and is fetched
# by internal/infrastructure/config_provider.go on startup.
#
# Seed it with:
#   consul kv put airflow-service/config @consul-kv.example.json
#
# See consul-kv.example.json in this directory for the payload, which points
# AirflowConfig.Host at the airflow-webserver-svc Service created by
# chart/airflow-server.
