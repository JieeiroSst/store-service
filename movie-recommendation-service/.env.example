PORT_HTTP_SERVER=8080
ALLOWED_ORIGINS=*

# Postgres (database is created and migrated on startup)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=movie_recommendation_service
POSTGRES_SSLMODE=disable

# video-service catalog source; empty disables sync (register videos via PUT instead)
VIDEO_SERVICE_BASE_URL=http://localhost:8081
VIDEO_SERVICE_TIMEOUT_SECONDS=15

# Model
SYNC_INTERVAL_SECONDS=300
TRAIN_INTERVAL_SECONDS=60
TRAIN_WINDOW_DAYS=90
TRENDING_HALF_LIFE_HOURS=168
NEW_HALF_LIFE_DAYS=14
# 0 disables re-ordering near-duplicates in feeds
DIVERSITY=0.25
SNAPSHOT_TTL_MINUTES=15
# Optional: keep ranking snapshots in Redis instead of Postgres
REDIS_ADDR=
REDIS_PASSWORD=
