  "query": "\n            SELECT b.BookingId, b.FromDate, b.ToDate, b.RoomNo, b.PassengerId,\n                   p.Name as PassengerName\n            FROM Bookings b\n            JOIN Passengers p ON b.PassengerId = p.PassengerId\n            WHERE b.BookingId = $1\n            ",
