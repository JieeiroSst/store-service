# REST gateway and /health
PORT=8080
# gRPC
GRPC_PORT=9090
SHUTDOWN_TIMEOUT=15s

# The database is created on startup if it does not exist, and the schema is
# migrated automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=hospital_patient_management_service
POSTGRES_SSLMODE=disable

# Every request must carry "Authorization: Bearer <session token>", validated
# by user-service. Use AUTH_MODE=off for local development only.
AUTH_MODE=token
USER_SERVICE_BASE_URL=http://localhost:8081
# How long a validated token is trusted before user-service is asked again
# (= how long a revoked token keeps working). 0 checks every request.
AUTH_CACHE_TTL=5s

# Sibling services. Each one is optional: leave its base URL empty to switch
# the integration off.

# Patient share of every bill is invoiced here.
BILLING_BASE_URL=http://localhost:8000
BILLING_PLAN_NAME=Hospital services

# Marking a bill Paid without a paid_date charges the patient's wallet
# (user_id = WALLET_USER_PREFIX + patient id) into the hospital wallet.
# Both WALLET_BASE_URL and WALLET_HOSPITAL_ID are required together.
WALLET_BASE_URL=
WALLET_HOSPITAL_ID=
WALLET_MINOR_UNIT=100
WALLET_USER_PREFIX=patient-

# Appointment, lab result, bill and payment messages to patients.
NOTIFICATION_BASE_URL=

# eKYC of patients (citizen card + face). A patient must first be linked to a
# user-service account: PUT /v1/patients/{id}/user {"user_id": "..."}.
EKYC_BASE_URL=

# Files attached to patients (scans, reports), stored by upload-service in a
# private bucket. The caller's bearer token is forwarded, so AUTH_MODE=token is
# needed for this to work against an upload-service that requires it.
#   POST/GET /v1/patients/{id}/documents, GET .../{doc}/content, DELETE .../{doc}
UPLOAD_BASE_URL=
