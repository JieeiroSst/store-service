# Consul bootstrap (optional) - when HostConsul/KeyConsul/ServiceConsul
# are all set, internal/infrastructure/config_provider.go fetches the
# whole config as JSON from that Consul KV key instead of the env vars
# below, falling back to them if Consul is unreachable/unset. Leave these
# blank for local development.
HostConsul=""
KeyConsul="ekyc_service"
ServiceConsul="consul"

PORT_HTTP_SERVER=8087

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=ekyc
POSTGRES_SSLMODE=disable

USER_SERVICE_BASE_URL=http://localhost:8080
USER_SERVICE_TIMEOUT=5s

# MinIO/S3 static-file storage (card photos, chip portraits, face-scan
# crops) - see internal/adapter/secondary/storage.
S3_ENDPOINT=localhost:9000
S3_BUCKET=ekyc-service
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_USE_SSL=false

# Thresholds for the in-house MRZ/face algorithms - see
# internal/adapter/secondary/{cardreader,facebio} and config.EkycConfig.
EKYC_MRZ_MIN_CONFIDENCE=0.85
EKYC_FACE_MATCH_THRESHOLD=0.6
EKYC_FACE_MIN_QUALITY=15.0

# "native" (in-house Go algorithms, default) or "python" (heavier
# dlib/EasyOCR subprocess adapter - see
# internal/adapter/secondary/pyextract and python/extract_id.py; needs the
# python Docker image variant and a working Python environment).
CARD_READER_PROVIDER=python
FACE_ANALYZER_PROVIDER=python

# Only read when a Providers.* var above is "python".
PYTHON_BIN=python3
PYTHON_EXTRACT_SCRIPT=python/extract_id.py
PYTHON_TIMEOUT=30s
