HTTP_PORT=9000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lucky_service
DB_SSLMODE=disable

USER_SERVICE_URL=http://localhost:8080
INTERNAL_API_TOKENS=

RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=lucky
RABBITMQ_ROUTING_KEY=lucky.reward.granted
RELAY_INTERVAL=10s
RELAY_GRACE=5s
RELAY_BATCH=100

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=lucky:
CACHE_CAMPAIGN_TTL=15s
WINNER_FEED_SIZE=50
RATE_LIMIT_PLAYS_PER_MINUTE=30

FRAUD_REQUIRE_DEVICE=false
FRAUD_MAX_USERS_PER_DEVICE=3
FRAUD_MAX_USERS_PER_IP=50
