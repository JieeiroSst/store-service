PORT=8080
SHUTDOWN_TIMEOUT=15s

# File metadata
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=upload

# File bytes: a private bucket, created on startup. Files are only ever served
# through this service, never through a public URL.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=upload-service
MINIO_USE_SSL=false

# Every route requires "Authorization: Bearer <session token>", validated by
# user-service. Use AUTH_MODE=off for local development only.
AUTH_MODE=token
USER_SERVICE_BASE_URL=http://localhost:8081
# How long a validated token is trusted (= how long a revoked one keeps working).
AUTH_CACHE_TTL=5s

# Upload limits. The type is detected from the file's bytes, not its name.
UPLOAD_MAX_MB=20
UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/gif

# Browser origins allowed to call the API (comma separated); empty allows none.
CORS_ALLOW_ORIGINS=
