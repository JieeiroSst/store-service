type MedicalMedicineList {
  items: [MedicalMedicine!]
  total: Int
}

type MedicalMedicine {
  id: Int
  code: String
  name: String
  ingredients: [String!]
  allergen_groups: [String!]
  dosage_form: String
  strength: String
  unit: String
  requires_prescription: Boolean
  reorder_level: Int
  created_at: String
  updated_at: String
}

type MedicalStockSummary {
  medicine_id: Int
  available: Int
  expired: Int
  batches: [MedicalBatch!]
}

type MedicalStockMovement {
  id: Int
  medicine_id: Int
  batch_id: Int
  type: String
  quantity: Int
  reason: String
  reference: String
  created_by: String
  created_at: String
}

type MedicalBatch {
  id: Int
  medicine_id: Int
  batch_number: String
  expiry_date: String
  quantity: Int
  received_quantity: Int
  unit_cost: Int
  supplier: String
  received_at: String
  created_at: String
  updated_at: String
}

type MedicalLowStockItem {
  medicine: MedicalMedicine
  available: Int
}

type MedicalInteractionRule {
  id: Int
  ingredient_a: String
  ingredient_b: String
  severity: String
  description: String
  source: String
  created_at: String
  updated_at: String
}

type MedicalTerminologyList {
  aliases: [MedicalIngredientAlias!]
  allergen_groups: [MedicalIngredientAllergenGroup!]
}

type MedicalDispense {
  id: Int
  patient_ref: String
  prescription_ref: String
  dispensed_by: String
  override_reason: String
  warnings: [MedicalWarning!]
  items: [MedicalDispenseItem!]
  created_at: String
}

type MedicalIngredientAlias {
  id: Int
  alias: String
  canonical: String
  source: String
  created_at: String
}

type MedicalIngredientAllergenGroup {
  id: Int
  ingredient: String
  allergen_group: String
  source: String
  created_at: String
}

type MedicalWarning {
  type: String
  severity: String
  medicines: [String!]
  ingredients: [String!]
  description: String
}

type MedicalDispenseItem {
  id: Int
  dispense_id: Int
  medicine_id: Int
  batch_id: Int
  batch_number: String
  expiry_date: String
  quantity: Int
}

input MedicalMedicineInput {
  code: String
  name: String
  ingredients: [String!]
  allergen_groups: [String!]
  dosage_form: String
  strength: String
  unit: String
  requires_prescription: Boolean
  reorder_level: Int
}

input MedicalBatchInput {
  batch_number: String
  expiry_date: String
  quantity: Int
  unit_cost: Int
  supplier: String
}

input MedicalAdjustInput {
  quantity: Int
  reason: String
}

input MedicalInteractionInput {
  ingredient_a: String
  ingredient_b: String
  severity: String
  description: String
}

input MedicalSafetyCheckInput {
  medicine_ids: [Int!]
  current_medicine_ids: [Int!]
  allergies: [String!]
}

input MedicalDispenseItemInput {
  medicine_id: Int
  quantity: Int
}

input MedicalDispenseInput {
  patient_ref: String
  prescription_ref: String
  items: [MedicalDispenseItemInput!]
  current_medicine_ids: [Int!]
  allergies: [String!]
  override_reason: String
}

type MedicalSafetyCheck {
  safe: Boolean
  warnings: [MedicalWarning!]
}

extend type Query {
  medicalMedicines(q: String, limit: Int, offset: Int): MedicalMedicineList @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/medicines")
  medicalMedicine(id: Int!): MedicalMedicine @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/medicines/{id}")
  medicalStock(id: Int!): MedicalStockSummary @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/medicines/{id}/stock")
  medicalMovements(id: Int!, limit: Int, offset: Int): [MedicalStockMovement!] @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/medicines/{id}/movements", unwrap: "items")
  medicalExpiring(days: Int): [MedicalBatch!] @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/inventory/expiring", unwrap: "items")
  medicalLowStock: [MedicalLowStockItem!] @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/inventory/low-stock", unwrap: "items")
  medicalInteractions(limit: Int, offset: Int): [MedicalInteractionRule!] @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/interactions", unwrap: "items")
  medicalTerminology: MedicalTerminologyList @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/terminology")
  medicalDispenses(patient_ref: String, limit: Int, offset: Int): [MedicalDispense!] @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/dispenses", unwrap: "items")
  medicalDispense(id: Int!): MedicalDispense @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", path: "/api/v1/dispenses/{id}")
  medicalCheckSafety(input: MedicalSafetyCheckInput!): Any @hasPermission(object: "/graphql/medical-service", action: "QUERY") @rest(service: "medical-service", method: "POST", path: "/api/v1/interactions/check")
}

extend type Mutation {
  medicalCreateMedicine(input: MedicalMedicineInput!): MedicalMedicine @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/medicines")
  medicalReceiveBatch(id: Int!, input: MedicalBatchInput!): MedicalBatch @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/medicines/{id}/batches", userField: "received_by")
  medicalAdjustBatch(id: Int!, input: MedicalAdjustInput!): Any @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/batches/{id}/adjust", userField: "adjusted_by")
  medicalDisposeExpired: Any @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/inventory/dispose-expired", userField: "disposed_by")
  medicalCreateInteraction(input: MedicalInteractionInput!): MedicalInteractionRule @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/interactions")
  medicalAddAlias(alias: String!, canonical: String!): MedicalIngredientAlias @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/terminology/aliases")
  medicalAddAllergenGroup(ingredient: String!, allergen_group: String!): MedicalIngredientAllergenGroup @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/terminology/allergen-groups")
  medicalCreateDispense(input: MedicalDispenseInput!): MedicalDispense @hasPermission(object: "/graphql/medical-service", action: "MUTATION") @rest(service: "medical-service", method: "POST", path: "/api/v1/dispenses", userField: "dispensed_by")
}
