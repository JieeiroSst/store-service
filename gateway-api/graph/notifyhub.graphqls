type HubJobPage {
  data: [HubNotifyJob!]
  total: Int
  page: Int
  page_size: Int
  ts: Int
  request_id: String
}

type HubHistoryPage {
  data: [HubNotifyHistory!]
  total: Int
  page: Int
  page_size: Int
  ts: Int
  request_id: String
}

type HubSchedulerStatus {
  scheduled_jobs: [String!]
  count: Int
  ts: Int
}

type HubChannel {
  id: String
  name: String
  type: String
  is_active: Boolean
  created_at: String
  updated_at: String
}

type HubDataSource {
  id: String
  name: String
  url: String
  method: String
  headers: Map
  body: String
  auth_type: String
  json_path: String
  is_active: Boolean
  created_at: String
  updated_at: String
}

type HubTemplate {
  id: String
  name: String
  channel: String
  subject: String
  body: String
  variables: [String!]
  is_active: Boolean
  created_at: String
  updated_at: String
}

type HubNotifyJob {
  id: String
  name: String
  description: String
  channel_id: String
  template_id: String
  data_source_id: String
  schedule_type: String
  cron_expr: String
  run_at: String
  interval_sec: Int
  recipients: [String!]
  static_payload: Map
  status: String
  last_run_at: String
  next_run_at: String
  run_count: Int
  fail_count: Int
  max_runs: Int
  created_at: String
  updated_at: String
  channel: HubChannel
  template: HubTemplate
  data_source: HubDataSource
}

type HubNotifyHistory {
  id: String
  job_id: String
  channel_type: String
  recipient: String
  subject: String
  body: String
  status: String
  retry_count: Int
  error: String
  sent_at: String
  created_at: String
  updated_at: String
}

input HubChannelInput {
  name: String
  type: String
  is_active: Boolean
}

input HubDataSourceInput {
  name: String
  url: String
  method: String
  headers: Map
  body: String
  auth_type: String
  json_path: String
  is_active: Boolean
}

input HubTemplateInput {
  name: String
  channel: String
  subject: String
  body: String
  variables: [String!]
  is_active: Boolean
}

input HubNotifyJobInput {
  name: String
  description: String
  channel_id: String
  template_id: String
  data_source_id: String
  schedule_type: String
  cron_expr: String
  run_at: String
  interval_sec: Int
  recipients: [String!]
  static_payload: Map
  status: String
  last_run_at: String
  next_run_at: String
  run_count: Int
  fail_count: Int
  max_runs: Int
  channel: Map
  template: Map
  data_source: Map
}

extend type Query {
  hubChannels(type: String, active: Boolean): [HubChannel!] @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/channels", unwrap: "data")
  hubChannel(id: String!): HubChannel @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/channels/{id}", unwrap: "data")
  hubDataSources: [HubDataSource!] @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/data-sources", unwrap: "data")
  hubDataSource(id: String!): HubDataSource @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/data-sources/{id}", unwrap: "data")
  hubTemplates(channel: String): [HubTemplate!] @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/templates", unwrap: "data")
  hubTemplate(id: String!): HubTemplate @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/templates/{id}", unwrap: "data")
  hubJobs(status: String, page: Int, page_size: Int): HubJobPage @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/jobs")
  hubJob(id: String!): HubNotifyJob @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/jobs/{id}", unwrap: "data")
  hubHistory(job_id: String, status: String, page: Int, page_size: Int): HubHistoryPage @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/history")
  hubSchedulerStatus: HubSchedulerStatus @hasPermission(object: "/graphql/notifyhub-service", action: "QUERY") @rest(service: "notifyhub-service", path: "/api/v1/scheduler/status")
}

extend type Mutation {
  hubCreateChannel(input: HubChannelInput!): HubChannel @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/channels", unwrap: "data")
  hubUpdateChannel(id: String!, input: HubChannelInput!): HubChannel @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "PUT", path: "/api/v1/channels/{id}", unwrap: "data")
  hubDeleteChannel(id: String!): Boolean! @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "DELETE", path: "/api/v1/channels/{id}")
  hubCreateDataSource(input: HubDataSourceInput!): HubDataSource @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/data-sources", unwrap: "data")
  hubUpdateDataSource(id: String!, input: HubDataSourceInput!): HubDataSource @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "PUT", path: "/api/v1/data-sources/{id}", unwrap: "data")
  hubDeleteDataSource(id: String!): Boolean! @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "DELETE", path: "/api/v1/data-sources/{id}")
  hubCreateTemplate(input: HubTemplateInput!): HubTemplate @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/templates", unwrap: "data")
  hubUpdateTemplate(id: String!, input: HubTemplateInput!): HubTemplate @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "PUT", path: "/api/v1/templates/{id}", unwrap: "data")
  hubDeleteTemplate(id: String!): Boolean! @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "DELETE", path: "/api/v1/templates/{id}")
  hubCreateJob(input: HubNotifyJobInput!): HubNotifyJob @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/jobs", unwrap: "data")
  hubUpdateJob(id: String!, input: HubNotifyJobInput!): HubNotifyJob @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "PUT", path: "/api/v1/jobs/{id}", unwrap: "data")
  hubDeleteJob(id: String!): Boolean! @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "DELETE", path: "/api/v1/jobs/{id}")
  hubPauseJob(id: String!): Any @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/jobs/{id}/pause", unwrap: "data")
  hubResumeJob(id: String!): Any @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/jobs/{id}/resume", unwrap: "data")
  hubTriggerJob(id: String!): Any @hasPermission(object: "/graphql/notifyhub-service", action: "MUTATION") @rest(service: "notifyhub-service", method: "POST", path: "/api/v1/jobs/{id}/trigger", unwrap: "data")
}
