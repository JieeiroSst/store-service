  crmContracts(offset: Int, limit: Int, q: String, account_id: Int, contract_status: String): [CrmContract!]! @hasPermission(object: "/graphql/customer-relationship-service", action: "QUERY") @rest(service: "customer-relationship-service", path: "/api/v1/contracts")
