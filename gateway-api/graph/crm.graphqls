  crmAccountContactRoles(offset: Int, limit: Int, q: String, contact_id: Int, account_id: Int): [CrmAccountContactRole!]! @hasPermission(object: "/graphql/customer-relationship-service", action: "QUERY") @rest(service: "customer-relationship-service", path: "/api/v1/account-contact-roles")
  crmAccountContactRole(id: Int!): CrmAccountContactRole @hasPermission(object: "/graphql/customer-relationship-service", action: "QUERY") @rest(service: "customer-relationship-service", path: "/api/v1/account-contact-roles/{id}")
  crmOpportunities(offset: Int, limit: Int, q: String, account_id: Int, opportunity_stage: String): [CrmOpportunity!]! @hasPermission(object: "/graphql/customer-relationship-service", action: "QUERY") @rest(service: "customer-relationship-service", path: "/api/v1/opportunities")
