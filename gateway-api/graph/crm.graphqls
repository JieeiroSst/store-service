type CrmCampaign {
  id: Int!
  created_at: String
  updated_at: String
  campaign_name: String!
  campaign_objectives: String!
  campaign_sponsor: String!
  campaign_start_date: String
  campaign_end_date: String
  campaign_other_details: String!
}

input CrmCampaignInput {
  campaign_name: String
  campaign_objectives: String
  campaign_sponsor: String
  campaign_start_date: String
  campaign_end_date: String
  campaign_other_details: String
}

type CrmLead {
  id: Int!
  created_at: String
  updated_at: String
  lead_firstname: String!
  lead_surname: String!
  email: String!
  phone: String!
  source: String!
  lead_other_details: String!
  status: String!
  converted_account_id: Int
  converted_contact_id: Int
}

input CrmLeadInput {
  lead_firstname: String
  lead_surname: String
  email: String
  phone: String
  source: String
  lead_other_details: String
  status: String
  converted_account_id: Int
  converted_contact_id: Int
}

type CrmAccount {
  id: Int!
  created_at: String
  updated_at: String
  account_name: String!
  account_description: String!
  account_phone: String!
  billing_address: String!
  email: String!
  tax_code: String!
  representative: String!
  representative_title: String!
}

input CrmAccountInput {
  account_name: String
  account_description: String
  account_phone: String
  billing_address: String
  email: String
  tax_code: String
  representative: String
  representative_title: String
}

type CrmContact {
  id: Int!
  created_at: String
  updated_at: String
  account_id: Int!
  name: String!
  email: String!
  phone: String!
  contact_address: String!
  contact_contact_details: String!
}

input CrmContactInput {
  account_id: Int
  name: String
  email: String
  phone: String
  contact_address: String
  contact_contact_details: String
}

type CrmCampaignMember {
  id: Int!
  created_at: String
  updated_at: String
  campaign_id: Int!
  lead_id: Int!
  contact_id: Int!
}

input CrmCampaignMemberInput {
  campaign_id: Int
  lead_id: Int
  contact_id: Int
}

type CrmCase {
  id: Int!
  created_at: String
  updated_at: String
  contact_id: Int!
  subject: String!
  description: String!
  priority: String!
  status: String!
  closed_at: String
}

input CrmCaseInput {
  contact_id: Int
  subject: String
  description: String
  priority: String
  status: String
  closed_at: String
}

type CrmContract {
  id: Int!
  created_at: String
  updated_at: String
  account_id: Int!
  contract_number: String!
  contract_title: String!
  end_date: String
  contract_status: String!
  contract_approval: String!
  signed_by: String!
  signed_at: String
  signature_algorithm: String!
  signature: String!
  signer_certificate: String!
  signer_subject: String!
  signer_serial: String!
  signer_fingerprint: String!
  signature_payload_hash: String!
  signature_format: String!
  revocation_status: String!
  countersigner_subject: String!
  countersigner_serial: String!
  countersigner_fingerprint: String!
  countersigned_at: String
  timestamp_token: String!
  timestamp_at: String
  timestamp_authority: String!
}

input CrmContractInput {
  account_id: Int
  contract_number: String
  contract_title: String
  end_date: String
  contract_status: String
  contract_approval: String
  signed_by: String
  signed_at: String
  signature_algorithm: String
  signature: String
  signer_certificate: String
  signer_subject: String
  signer_serial: String
  signer_fingerprint: String
  signature_payload_hash: String
  signature_format: String
  revocation_status: String
  countersigner_subject: String
  countersigner_serial: String
  countersigner_fingerprint: String
  countersigned_at: String
  timestamp_token: String
  timestamp_at: String
  timestamp_authority: String
}

type CrmAccountContactRole {
  id: Int!
  created_at: String
  updated_at: String
  contact_id: Int!
  account_id: Int!
}

input CrmAccountContactRoleInput {
  contact_id: Int
  account_id: Int
}

type CrmOpportunity {
  id: Int!
  created_at: String
  updated_at: String
  account_id: Int!
  opportunity_description: String!
  opportunity_details: String!
  amount: Float!
  close_date: String
  opportunity_stage: String!
}

input CrmOpportunityInput {
  account_id: Int
  opportunity_description: String
  opportunity_details: String
  amount: Float
  close_date: String
  opportunity_stage: String
}

type CrmOpportunityContactRole {
  id: Int!
  created_at: String
  updated_at: String
  contact_id: Int!
  opportunity_id: Int!
  date_time: String
  other_details: String!
}

input CrmOpportunityContactRoleInput {
  contact_id: Int
  opportunity_id: Int
  date_time: String
  other_details: String
}

type CrmFileKind {
  kind: String!
  label: String!
  formats: [String!]
  system: Boolean!
}

type CrmContractFile {
  id: Int!
  created_at: String
  updated_at: String
  contract_id: Int!
  kind: String!
  name: String!
  content_type: String!
  format: String!
  size: Int!
  sha256: String!
  description: String!
  uploaded_by: String!
  uploader_id: String!
  source: String!
  lineage_id: Int!
  version: Int!
  latest: Boolean!
  replaces_id: Int
  scan_status: String!
  scan_engine: String!
  scanned_at: String
}

type CrmContractFileEvent {
  id: Int!
  at: String
  contract_id: Int!
  file_id: Int!
  lineage_id: Int!
  version: Int!
  file_name: String!
  kind: String!
  action: String!
  actor_id: String!
  actor_name: String!
  actor_roles: String!
  actor_service: Boolean!
  ip: String!
  detail: String!
}

type CrmFileHistory {
  versions: [CrmContractFile!]!
  events: [CrmContractFileEvent!]!
}

type CrmConvertLeadResult {
  lead: CrmLead
  account: CrmAccount
  contact: CrmContact
  opportunity: CrmOpportunity
}

input CrmConvertLeadInput {
  account_name: String
  create_opportunity: Boolean
  opportunity_description: String
  opportunity_amount: Float
}

input CrmSignContractInput {
  signed_by: String
  end_date: String
  signing_time: String
  algorithm: String
  signature: String
  certificate: String
  signed_pdf: String
}

type CrmAccountOverview {
  account: CrmAccount
  contacts: [CrmContact!]
  contracts: [CrmContract!]
  opportunities: [CrmOpportunity!]
}

type CrmStageSummary {
  stage: String!
  count: Int!
  amount: Float!
}

type CrmSummary {
  counts: Map
  leads_by_status: Map
  open_cases: Int!
  pipeline: [CrmStageSummary!]
}

extend type Query {
  crmCampaigns(offset: Int, limit: Int, q: String): [CrmCampaign!]! @hasPermission(object: "/graphql/customer-relationship-service", action: "QUERY") @rest(service: "customer-relationship-service", path: "/api/v1/campaigns")
