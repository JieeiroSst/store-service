  netSessionInfo(id: String!, query: Map): Any @hasPermission(object: "/graphql/networking-service", action: "QUERY") @rest(service: "networking-service", path: "/v1/session/info/{id}")
  netSessionList(query: Map): Any @hasPermission(object: "/graphql/networking-service", action: "QUERY") @rest(service: "networking-service", path: "/v1/session/list")
