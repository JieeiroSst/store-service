type QrQRListResponse {
  data: [QrQRCode!]
  total: Int
  page: Int
  limit: Int
  total_pages: Int
}

type QrQRCode {
  id: String
  short_code: String
  title: String
  type: String
  content: String
  redirect_url: String
  image_base64: String
  image_url: String
  status: String
  scan_count: Int
  size: Int
  fore_color: String
  back_color: String
  expires_at: String
  created_at: String
  updated_at: String
  created_by: String
}

type QrScanHistoryResponse {
  data: [QrScanHistory!]
  total: Int
  page: Int
  limit: Int
  total_pages: Int
}

type QrScanStats {
  total_scans: Int
  unique_ips: Int
  device_breakdown: Map
  os_breakdown: Map
  daily_scans: [QrDailyScan!]
}

type QrScanHistory {
  id: String
  qr_code_id: String
  short_code: String
  ip_address: String
  user_agent: String
  referer: String
  country: String
  city: String
  device_type: String
  os: String
  browser: String
  scanned_at: String
}

type QrDailyScan {
  date: String
  count: Int
}

input QrGenerateInput {
  title: String
  type: String
  content: String
  redirect_url: String
  size: Int
  fore_color: String
  back_color: String
  expires_at: String
}

input QrUpdateInput {
  title: String
  status: String
  fore_color: String
  back_color: String
  expires_at: String
}

extend type Query {
  qrCodes(page: Int, limit: Int, status: String, type: String, search: String, created_by: String): QrQRListResponse @hasPermission(object: "/graphql/qr-service", action: "QUERY") @rest(service: "qr-service", path: "/api/v1/qr", unwrap: "data")
  qrCode(id: String!): QrQRCode @hasPermission(object: "/graphql/qr-service", action: "QUERY") @rest(service: "qr-service", path: "/api/v1/qr/{id}", unwrap: "data")
  qrScanHistory(id: String!, page: Int, limit: Int): QrScanHistoryResponse @hasPermission(object: "/graphql/qr-service", action: "QUERY") @rest(service: "qr-service", path: "/api/v1/qr/{id}/history", unwrap: "data")
  qrScanStats(id: String!): QrScanStats @hasPermission(object: "/graphql/qr-service", action: "QUERY") @rest(service: "qr-service", path: "/api/v1/qr/{id}/stats", unwrap: "data")
  myQrCodes(page: Int, limit: Int, status: String, type: String, search: String): QrQRListResponse @rest(service: "qr-service", path: "/api/v1/qr", unwrap: "data", userQuery: "created_by")
  myQrCode(id: String!): QrQRCode @rest(service: "qr-service", path: "/api/v1/qr/{id}", unwrap: "data", owner: "created_by")
  myQrScanStats(id: String!): QrScanStats @rest(service: "qr-service", path: "/api/v1/qr/{id}/stats", unwrap: "data", owner: "created_by", ownerPath: "/api/v1/qr/{id}", ownerUnwrap: "data")
}

extend type Mutation {
  createMyQrCode(input: QrGenerateInput!): QrQRCode @rest(service: "qr-service", method: "POST", path: "/api/v1/qr", unwrap: "data", userField: "created_by")
  updateMyQrCode(id: String!, input: QrUpdateInput!): QrQRCode @rest(service: "qr-service", method: "PUT", path: "/api/v1/qr/{id}", unwrap: "data", owner: "created_by", ownerPath: "/api/v1/qr/{id}", ownerUnwrap: "data")
  updateMyQrContent(id: String!, content: String, redirect_url: String): QrQRCode @rest(service: "qr-service", method: "PATCH", path: "/api/v1/qr/{id}/content", unwrap: "data", owner: "created_by", ownerPath: "/api/v1/qr/{id}", ownerUnwrap: "data")
  deleteMyQrCode(id: String!): Boolean! @rest(service: "qr-service", method: "DELETE", path: "/api/v1/qr/{id}", owner: "created_by", ownerPath: "/api/v1/qr/{id}", ownerUnwrap: "data")
  regenerateMyQrCode(id: String!): QrQRCode @rest(service: "qr-service", method: "POST", path: "/api/v1/qr/{id}/regenerate", unwrap: "data", owner: "created_by", ownerPath: "/api/v1/qr/{id}", ownerUnwrap: "data")
  qrGenerate(input: QrGenerateInput!): QrQRCode @hasPermission(object: "/graphql/qr-service", action: "MUTATION") @rest(service: "qr-service", method: "POST", path: "/api/v1/qr", unwrap: "data", userField: "created_by")
  qrUpdate(id: String!, input: QrUpdateInput!): QrQRCode @hasPermission(object: "/graphql/qr-service", action: "MUTATION") @rest(service: "qr-service", method: "PUT", path: "/api/v1/qr/{id}", unwrap: "data")
  qrUpdateContent(id: String!, content: String, redirect_url: String): QrQRCode @hasPermission(object: "/graphql/qr-service", action: "MUTATION") @rest(service: "qr-service", method: "PATCH", path: "/api/v1/qr/{id}/content", unwrap: "data")
  qrDelete(id: String!): Boolean! @hasPermission(object: "/graphql/qr-service", action: "MUTATION") @rest(service: "qr-service", method: "DELETE", path: "/api/v1/qr/{id}")
  qrRegenerate(id: String!): QrQRCode @hasPermission(object: "/graphql/qr-service", action: "MUTATION") @rest(service: "qr-service", method: "POST", path: "/api/v1/qr/{id}/regenerate", unwrap: "data")
}
