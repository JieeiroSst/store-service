type PhotoComposition {
  id: String
  owner_id: String
  status: String
  layout: PhotolayoutDTO
  sources: [PhotosourceDTO!]
  object_key: String
  url: String
  width: Int
  height: Int
  format: String
  size_bytes: Int
  error_message: String
  created_at: String
  updated_at: String
}

type PhotolayoutDTO {
  type: String
  rows: Int
  cols: Int
  width: Int
  height: Int
  spacing: Int
  padding: Int
  background: String
  cell_fit: String
  cells: [PhotocellDTO!]
  format: String
  quality: Int
}

type PhotosourceDTO {
  type: String
  url: String
  object_key: String
  order: Int
}

type PhotocellDTO {
  x: Int
  y: Int
  width: Int
  height: Int
  image_index: Int
}

extend type Query {
  photoComposition(id: String!): PhotoComposition @rest(service: "photo-service", path: "/v1/compositions/{id}", owner: "owner_id")
  myPhotoCompositions(limit: Int): [PhotoComposition!]! @rest(service: "photo-service", path: "/v1/compositions", userQuery: "owner_id")
}

extend type Mutation {
  photoCreateComposition(images: [Upload!], urls: [String!], layout: String): PhotoComposition @rest(service: "photo-service", method: "POST", path: "/v1/compositions", multipart: true, userField: "owner_id")
}
