type FoodFood {
  id: Int
  name: String
  description: String
  price: Int
  category: String
  restaurant_id: Int
  is_active: Boolean
}

type FoodRestaurant {
  id: Int
  name: String
  description: String
  address: String
  image_url: String
  is_active: Boolean
  commission_rate: Float
}

input FoodRestaurantInput {
  name: String
  description: String
  address: String
  image_url: String
  is_active: Boolean
  commission_rate: Float
}

input FoodFoodInput {
  name: String
  description: String
  price: Int
  category: String
  restaurant_id: Int
  is_active: Boolean
}

type FoodAllergen {
  id: Int
  name: String
}

type FoodIngredient {
  id: Int
  name: String
  unit: String
}

extend type Query {
  food(id: Int!): FoodFood @public @rest(service: "food-service", path: "/api/food/{id}")
  foods: [FoodFood!] @public @rest(service: "food-service", path: "/api/food/")
  foodSearchFoods(name: String!): [FoodFood!] @public @rest(service: "food-service", path: "/api/food/search")
  foodRestaurants(q: String): [FoodRestaurant!] @public @rest(service: "food-service", path: "/api/restaurants")
  foodRestaurant(id: Int!): FoodRestaurant @public @rest(service: "food-service", path: "/api/restaurants/{id}")
  foodRestaurantMenu(id: Int!): [FoodFood!] @public @rest(service: "food-service", path: "/api/restaurants/{id}/foods")
}

extend type Mutation {
  foodCreateFood(input: FoodFoodInput!): FoodFood @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "POST", path: "/api/food")
  foodUpdateFood(id: Int!, input: FoodFoodInput!): FoodFood @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "PUT", path: "/api/food/{id}")
  foodDeleteFood(id: Int!): Boolean! @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "DELETE", path: "/api/food/{id}")
  foodDeleteAllFoods: Boolean! @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "DELETE", path: "/api/food/")
  foodCreateAllergen(name: String!): FoodAllergen @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "POST", path: "/api/allergens")
  foodCreateIngredient(name: String!, unit: String): FoodIngredient @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "POST", path: "/api/ingredient")
  foodCreateRestaurant(input: FoodRestaurantInput!): FoodRestaurant @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "POST", path: "/api/restaurants")
  foodUpdateRestaurant(id: Int!, input: FoodRestaurantInput!): FoodRestaurant @hasPermission(object: "/graphql/food-service", action: "MUTATION") @rest(service: "food-service", method: "PUT", path: "/api/restaurants/{id}")
}
