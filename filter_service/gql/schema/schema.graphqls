directive @goTag(key: String!, value: String) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

scalar Map
scalar Any

type Query {
  """Downstream services reachable through this gateway."""
  services: [GatewayService!]!
}

type GatewayService {
  name: String!
  field: String!
  envVar: String!
  baseURL: String!
  endpoints: Int!
}
