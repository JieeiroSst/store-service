extend type Query {
  """GET endpoints of movie-recommendation-service"""
  movieRecommendationService: MovieQuery!
}

type MovieQuery {
  """
  GET /api/recommendations/users/{user_id}
  """
  forUser(user_id: String!, page: Int, page_size: Int, snapshot: String): MoviePage

  """
  GET /api/recommendations/users/{user_id}/home
  """
  home(user_id: String!): MovieHome

  """
  GET /api/recommendations/users/{user_id}/continue-watching
  """
  continueWatching(user_id: String!, page: Int, page_size: Int, snapshot: String): MoviePage

  """
  GET /api/recommendations/users/{user_id}/history
  """
  history(user_id: String!, page: Int, page_size: Int, snapshot: String): MoviePage

  """
  GET /api/recommendations/new
  """
  newReleases(page: Int, page_size: Int, snapshot: String): MoviePage

  """
  GET /api/recommendations/videos/{id}/similar
  """
  similar(id: String!, page: Int, page_size: Int, snapshot: String): MoviePage

  """
  GET /api/recommendations/trending
  """
  trending(page: Int, page_size: Int, snapshot: String): MoviePage
}

type MoviePage {
  items: [MovieRecommendation!]
  total: Int
  page: Int
  page_size: Int
  snapshot: String
}

type MovieHome {
  sections: [MovieSection!]
}

type MovieRecommendation {
  video: MovieVideo
  score: Float
  reason: String
  because: MovieVideo
  progress: Float
  at: String
}

type MovieSection {
  id: String
  title: String
  items: [MovieRecommendation!]
}

type MovieVideo {
  id: String
  title: String
  description: String
  tags: [String!]
  status: String
  duration: Float
  views: Int
  created_at: String
}
