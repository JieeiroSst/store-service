extend type Query {
  """GET endpoints of kms-service"""
  kmsService: KmsQuery!
}

type KmsQuery {
  """
  GET /api/v1/keys
  """
  keys: [KmsKey!]

  """
  GET /api/v1/keys/{id}
  """
  key(id: String!): KmsKey

  """
  GET /api/v1/keys/{id}/use
  
  Marks the key as used (increments use_count) and returns its metadata.
  """
  keyForUse(id: String!): KmsKeyUse

  """
  GET /api/v1/keys/{id}/stats
  """
  keyUsageStats(id: String!): KmsKeyStats

  """
  GET /api/v1/keys/{id}/audit
  """
  keyAuditLogs(id: String!, limit: Int, offset: Int): KmsKeyAuditLogs

  """
  GET /api/v1/audit/logs
  """
  auditLogs(limit: Int, offset: Int): KmsAuditLogs
}

type KmsKeyUse {
  key: KmsKey
  message: String
}

type KmsKeyStats {
  key_id: String
  alias: String
  use_count: Int
  created_at: String
  last_rotated_at: String
  expires_at: String
  status: String
  version: Int
}

type KmsKeyAuditLogs {
  key_id: String
  logs: [KmsAuditLog!]
  limit: Int
  offset: Int
}

type KmsAuditLogs {
  logs: [KmsAuditLog!]
  limit: Int
  offset: Int
}

type KmsKey {
  id: String
  alias: String
  algorithm: String
  key_length: Int
  created_at: String
  updated_at: String
  expires_at: String
  last_rotated_at: String
  status: String
  version: Int
  created_by: Int
  tags: Map
  use_count: Int
}

type KmsAuditLog {
  id: String
  actor_id: Int
  actor_name: String
  action: String
  resource: String
  resource_id: String
  timestamp: String
  ip_address: String
  user_agent: String
  success: Boolean
  error_msg: String
  metadata: Map
  level: String
}
