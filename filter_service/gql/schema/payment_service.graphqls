extend type Query {
  """GET endpoints of payment_service"""
  paymentService: PaymentQuery!
}

type PaymentQuery {
  """
  GET /api/v1/payments
  
  from/to are RFC3339.
  """
  payments(provider: String, status: String, from: String, to: String, limit: Int, offset: Int): PaymentPaymentList

  """
  GET /api/v1/payments/{id}
  """
  payment(id: Int!): PaymentPayment

  """
  GET /api/v1/payments/{id}/transactions
  """
  transactions(id: Int!): [PaymentTransaction!]
}

type PaymentPaymentList {
  Items: [PaymentPayment!]
  Total: Int
}

type PaymentPayment {
  ID: Int
  Provider: String
  ExternalID: String
  Amount: Int
  Currency: String
  Status: String
  PayerEmail: String
  Description: String
  FailureReason: String
  IdempotencyKey: String
  RefundedAmount: Int
  CreatedAt: String
  UpdatedAt: String
}

type PaymentTransaction {
  ID: Int
  PaymentID: Int
  Type: String
  Status: String
  Amount: Int
  ExternalID: String
  RawStatus: String
  ErrorMessage: String
  CreatedAt: String
}
