extend type Query {
  """GET endpoints of wishlists-service"""
  wishlistsService: WishlistQuery!
}

type WishlistQuery {
  """
  GET /greet
  
  Greeting stored in Redis (gofr sample endpoint).
  """
  greet: String

  """
  GET /customer
  """
  customers: [WishlistCustomer!]
}

type WishlistCustomer {
  id: Int
  name: String
}
