extend type Query {
  """GET endpoints of notifyhub-service"""
  notifyhubService: HubQuery!
}

type HubQuery {
  """
  GET /api/v1/channels
  """
  channels(type: String, active: Boolean): [HubChannel!]

  """
  GET /api/v1/channels/{id}
  """
  channel(id: String!): HubChannel

  """
  GET /api/v1/data-sources
  """
  dataSources: [HubDataSource!]

  """
  GET /api/v1/data-sources/{id}
  """
  dataSource(id: String!): HubDataSource

  """
  GET /api/v1/templates
  """
  templates(channel: String): [HubTemplate!]

  """
  GET /api/v1/templates/{id}
  """
  template(id: String!): HubTemplate

  """
  GET /api/v1/jobs
  """
  jobs(status: String, page: Int, page_size: Int): HubJobPage

  """
  GET /api/v1/jobs/{id}
  """
  job(id: String!): HubNotifyJob

  """
  GET /api/v1/history
  """
  history(job_id: String, status: String, page: Int, page_size: Int): HubHistoryPage

  """
  GET /api/v1/scheduler/status
  """
  schedulerStatus: HubSchedulerStatus
}

type HubJobPage {
  data: [HubNotifyJob!]
  total: Int
  page: Int
  page_size: Int
  ts: Int
  request_id: String
}

type HubHistoryPage {
  data: [HubNotifyHistory!]
  total: Int
  page: Int
  page_size: Int
  ts: Int
  request_id: String
}

type HubSchedulerStatus {
  scheduled_jobs: [String!]
  count: Int
  ts: Int
}

type HubChannel {
  id: String
  name: String
  type: String
  is_active: Boolean
  created_at: String
  updated_at: String
}

type HubDataSource {
  id: String
  name: String
  url: String
  method: String
  headers: Map
  body: String
  auth_type: String
  json_path: String
  is_active: Boolean
  created_at: String
  updated_at: String
}

type HubTemplate {
  id: String
  name: String
  channel: String
  subject: String
  body: String
  variables: [String!]
  is_active: Boolean
  created_at: String
  updated_at: String
}

type HubNotifyJob {
  id: String
  name: String
  description: String
  channel_id: String
  template_id: String
  data_source_id: String
  schedule_type: String
  cron_expr: String
  run_at: String
  interval_sec: Int
  recipients: [String!]
  static_payload: Map
  status: String
  last_run_at: String
  next_run_at: String
  run_count: Int
  fail_count: Int
  max_runs: Int
  created_at: String
  updated_at: String
  channel: HubChannel
  template: HubTemplate
  data_source: HubDataSource
}

type HubNotifyHistory {
  id: String
  job_id: String
  channel_type: String
  recipient: String
  subject: String
  body: String
  status: String
  retry_count: Int
  error: String
  sent_at: String
  created_at: String
  updated_at: String
}
