extend type Query {
  """GET endpoints of medical-service"""
  medicalService: MedicalQuery!
}

type MedicalQuery {
  """
  GET /api/v1/medicines
  """
  medicines(q: String, limit: Int, offset: Int): MedicalMedicineList

  """
  GET /api/v1/medicines/{id}
  """
  medicine(id: Int!): MedicalMedicine

  """
  GET /api/v1/medicines/{id}/stock
  """
  stock(id: Int!): MedicalStockSummary

  """
  GET /api/v1/medicines/{id}/movements
  """
  movements(id: Int!, limit: Int, offset: Int): [MedicalStockMovement!]

  """
  GET /api/v1/inventory/expiring
  """
  expiring(days: Int): [MedicalBatch!]

  """
  GET /api/v1/inventory/low-stock
  """
  lowStock: [MedicalLowStockItem!]

  """
  GET /api/v1/interactions
  """
  interactions(limit: Int, offset: Int): [MedicalInteractionRule!]

  """
  GET /api/v1/terminology
  """
  terminology: MedicalTerminologyList

  """
  GET /api/v1/dispenses
  """
  dispenses(patient_ref: String, limit: Int, offset: Int): [MedicalDispense!]

  """
  GET /api/v1/dispenses/{id}
  """
  dispense(id: Int!): MedicalDispense
}

type MedicalMedicineList {
  items: [MedicalMedicine!]
  total: Int
}

type MedicalMedicine {
  id: Int
  code: String
  name: String
  ingredients: [String!]
  allergen_groups: [String!]
  dosage_form: String
  strength: String
  unit: String
  requires_prescription: Boolean
  reorder_level: Int
  created_at: String
  updated_at: String
}

type MedicalStockSummary {
  medicine_id: Int
  available: Int
  expired: Int
  batches: [MedicalBatch!]
}

type MedicalStockMovement {
  id: Int
  medicine_id: Int
  batch_id: Int
  type: String
  quantity: Int
  reason: String
  reference: String
  created_by: String
  created_at: String
}

type MedicalBatch {
  id: Int
  medicine_id: Int
  batch_number: String
  expiry_date: String
  quantity: Int
  received_quantity: Int
  unit_cost: Int
  supplier: String
  received_at: String
  created_at: String
  updated_at: String
}

type MedicalLowStockItem {
  medicine: MedicalMedicine
  available: Int
}

type MedicalInteractionRule {
  id: Int
  ingredient_a: String
  ingredient_b: String
  severity: String
  description: String
  source: String
  created_at: String
  updated_at: String
}

type MedicalTerminologyList {
  aliases: [MedicalIngredientAlias!]
  allergen_groups: [MedicalIngredientAllergenGroup!]
}

type MedicalDispense {
  id: Int
  patient_ref: String
  prescription_ref: String
  dispensed_by: String
  override_reason: String
  warnings: [MedicalWarning!]
  items: [MedicalDispenseItem!]
  created_at: String
}

type MedicalIngredientAlias {
  id: Int
  alias: String
  canonical: String
  source: String
  created_at: String
}

type MedicalIngredientAllergenGroup {
  id: Int
  ingredient: String
  allergen_group: String
  source: String
  created_at: String
}

type MedicalWarning {
  type: String
  severity: String
  medicines: [String!]
  ingredients: [String!]
  description: String
}

type MedicalDispenseItem {
  id: Int
  dispense_id: Int
  medicine_id: Int
  batch_id: Int
  batch_number: String
  expiry_date: String
  quantity: Int
}
