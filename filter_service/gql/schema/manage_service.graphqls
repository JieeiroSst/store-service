  exportIDPPublicBrokerConfig(realm: String!, alias: String!): String

  """
  GET /api/v1/admin/realms/{realm}/identity-providers/{alias}/mappers
  
  Keycloak GetIdentityProviderMappers. Admin API - uses the caller bearer token, or the service admin token when absent.
  """
  identityProviderMappers(realm: String!, alias: String!): [KcIdentityProviderMapper!]

  """
  GET /api/v1/admin/realms/{realm}/identity-providers/{alias}/mappers/{mapperID}
  
  Keycloak GetIdentityProviderMapperByID. Admin API - uses the caller bearer token, or the service admin token when absent.
  """
  identityProviderMapperByID(realm: String!, alias: String!, mapperID: String!): KcIdentityProviderMapper
}

