extend type Query {
  """GET endpoints of media-service"""
  mediaService: MediaQuery!
}

type MediaQuery {
  """
  GET /api/internal/v1/videos/{video_id}/user/{user_id}
  """
  video(video_id: Int!, user_id: Int!): MediaVideo
}

type MediaVideo {
  video_id: Int
  description: String
  thumbnail_url: String
  stream_url: String
  tag_id: Int
  uploaded_on: String
  tag: MediaTag
}

type MediaTag {
  tag_id: Int
  video_id: Int
  value: String
}
