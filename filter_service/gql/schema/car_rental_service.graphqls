extend type Query {
  """GET endpoints of car-rental-service"""
  carRentalService: CarRentalQuery!
}

type CarRentalQuery {
  """
  GET /api/v1/users/{user_id}
  
  gRPC VehicleRentalService.GetUser
  """
  getUser(user_id: String!): CarRentalUserResponse

  """
  GET /api/v1/vehicles/{vehicle_id}
  
  gRPC VehicleRentalService.GetVehicle
  """
  getVehicle(vehicle_id: String!): CarRentalVehicleResponse

  """
  GET /api/v1/vehicles
  
  gRPC VehicleRentalService.ListVehicles
  """
  listVehicles(page_size: Int, page_token: String, vehicle_type: String, location_id: String): CarRentalListVehiclesResponse

  """
  GET /api/v1/vehicles/available
  
  gRPC VehicleRentalService.SearchAvailableVehicles
  """
  searchAvailableVehicles(start_time: String, end_time: String, pickup_location_id: String, return_location_id: String, vehicle_type: String, category_id: String, page_size: Int, page_token: String): CarRentalListVehiclesResponse

  """
  GET /api/v1/reservations/{reservation_id}
  
  gRPC VehicleRentalService.GetReservation
  """
  getReservation(reservation_id: String!): CarRentalReservationResponse

  """
  GET /api/v1/users/{user_id}/reservations
  
  gRPC VehicleRentalService.ListUserReservations
  """
  listUserReservations(user_id: String!, status: String, page_size: Int, page_token: String): CarRentalListReservationsResponse

  """
  GET /api/v1/rentals/{rental_id}
  
  gRPC VehicleRentalService.GetRental
  """
  getRental(rental_id: String!): CarRentalRentalResponse

  """
  GET /api/v1/users/{user_id}/rentals
  
  gRPC VehicleRentalService.ListUserRentals
  """
  listUserRentals(user_id: String!, status: String, page_size: Int, page_token: String): CarRentalListRentalsResponse

  """
  GET /api/v1/vehicles/{vehicle_id}/reviews
  
  gRPC VehicleRentalService.ListVehicleReviews
  """
  listVehicleReviews(vehicle_id: String!, page_size: Int, page_token: String): CarRentalListReviewsResponse

  """
  GET /api/v1/locations
  
  gRPC VehicleRentalService.ListLocations
  """
  listLocations(city: String, state: String, country: String, page_size: Int, page_token: String): CarRentalListLocationsResponse
}

type CarRentalUserResponse {
  userId: String
  email: String
  firstName: String
  lastName: String
  phoneNumber: String
  address: String
  userType: String
  drivingLicense: String
  createdAt: String
  updatedAt: String
}

type CarRentalVehicleResponse {
  vehicleId: String
  categoryId: String
  registrationNumber: String
  make: String
  model: String
  year: Int
  color: String
  mileage: Float
  status: String
  hourlyRate: Float
  dailyRate: Float
  locationId: String
  vehicleType: String
  features: Map
  carDetails: CarRentalCarDetails
  motorcycleDetails: CarRentalMotorcycleDetails
  bicycleDetails: CarRentalBicycleDetails
}

type CarRentalCarDetails {
  fuelType: String
  transmission: String
  seatingCapacity: Int
  trunkCapacity: Float
  airConditioning: Boolean
}

type CarRentalMotorcycleDetails {
  engineCapacity: Int
  motorcycleType: String
  helmetIncluded: Boolean
}

type CarRentalBicycleDetails {
  bicycleType: String
  frameSize: String
  gearCount: Int
  hasBasket: Boolean
}

type CarRentalListVehiclesResponse {
  vehicles: [CarRentalVehicleResponse!]
  nextPageToken: String
  totalCount: Int
}

type CarRentalReservationResponse {
  reservationId: String
  userId: String
  vehicleId: String
  pickupLocationId: String
  returnLocationId: String
  startTime: String
  endTime: String
  status: String
  createdAt: String
  updatedAt: String
  vehicle: CarRentalVehicleResponse
}

type CarRentalListReservationsResponse {
  reservations: [CarRentalReservationResponse!]
  nextPageToken: String
  totalCount: Int
}

type CarRentalRentalResponse {
  rentalId: String
  reservationId: String
  vehicleId: String
  userId: String
  pickupTime: String
  actualReturnTime: String
  pickupLocationId: String
  returnLocationId: String
  pickupMileage: Float
  returnMileage: Float
  status: String
  baseFee: Float
  additionalFees: Float
  paymentStatus: String
  vehicle: CarRentalVehicleResponse
  createdAt: String
}

type CarRentalListRentalsResponse {
  rentals: [CarRentalRentalResponse!]
  nextPageToken: String
  totalCount: Int
}

type CarRentalListReviewsResponse {
  reviews: [CarRentalReviewResponse!]
  nextPageToken: String
  totalCount: Int
}

type CarRentalReviewResponse {
  reviewId: String
  rentalId: String
  userId: String
  vehicleId: String
  rating: Int
  comment: String
  createdAt: String
  user: CarRentalUserResponse
}

type CarRentalListLocationsResponse {
  locations: [CarRentalLocationResponse!]
  nextPageToken: String
  totalCount: Int
}

type CarRentalLocationResponse {
  locationId: String
  name: String
  address: String
  city: String
  state: String
  country: String
  zipCode: String
  latitude: Float
  longitude: Float
  contactPhone: String
  openingHours: Map
}
