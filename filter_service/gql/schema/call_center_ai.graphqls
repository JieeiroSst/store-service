extend type Query {
  """GET endpoints of call_center_ai"""
  callCenterAi: CallCenterQuery!
}

type CallCenterQuery {
  """
  GET /api/calls
  """
  calls(skip: Int, limit: Int, status: String, from_number: String): [CallCenterCall!]

  """
  GET /api/calls/{call_id}
  """
  call(call_id: Int!): CallCenterCallHistory

  """
  GET /api/scenarios
  """
  scenarios(skip: Int, limit: Int): [CallCenterScenario!]

  """
  GET /api/scenarios/{scenario_id}
  """
  scenario(scenario_id: Int!): CallCenterScenario

  """
  GET /api/customers/{phone_number}
  """
  customer(phone_number: String!): CallCenterCustomer

  """
  GET /api/analytics/statistics
  """
  statistics(days: Int): CallCenterCallStatistics
}

type CallCenterCall {
  id: Int
  call_sid: String
  from_number: String
  to_number: String
  notes: String
  status: String
  duration: Int
  start_time: String
  end_time: String
  recording_url: String
  created_at: String
  updated_at: String
}

type CallCenterMessage {
  id: Int
  call_id: Int
  role: String
  content: String
  audio_url: String
  timestamp: String
  processing_time: Float
}

type CallCenterCallHistory {
  id: Int
  call_sid: String
  from_number: String
  to_number: String
  notes: String
  status: String
  duration: Int
  start_time: String
  end_time: String
  recording_url: String
  created_at: String
  updated_at: String
  messages: [CallCenterMessage!]
}

type CallCenterScenario {
  id: Int
  name: String
  description: String
  prompt: String
  is_active: Int
  created_at: String
  updated_at: String
}

type CallCenterCustomer {
  id: Int
  phone_number: String
  name: String
  email: String
  notes: String
  total_calls: Int
  last_call_date: String
  created_at: String
  updated_at: String
}

type CallCenterCallStatistics {
  total_calls: Int
  completed_calls: Int
  failed_calls: Int
  average_duration: Float
  total_messages: Int
}
