# Server-only - never exposed to the browser. Base URL of the
# livestream_service edge role (see chart/livestream-service).
LIVESTREAM_SERVICE_URL=http://localhost:8080

# Server-only. Base URL of user_service's HTTP gateway (grpc-gateway,
# exposes POST /api/v1/login) - see user_service/di/server.go.
USER_SERVICE_URL=http://localhost:1235

# Browser-visible. Used only for the direct chat WebSocket connection
# (internal/adapter/primary/http/ws_handler.go on livestream_service) -
# everything else goes through this app's own /api/livestream proxy.
# NOTE: Next.js inlines NEXT_PUBLIC_* vars at build time, not at
# container start - changing this requires a rebuild, not just a
# redeploy (see Dockerfile / chart/livestream-web).
NEXT_PUBLIC_LIVESTREAM_WS_URL=ws://localhost:8080
