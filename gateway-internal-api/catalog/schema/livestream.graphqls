type LiveViewerCount {
  viewers: Int
}

type LiveRoom {
  id: String
  ownerUserId: String
  slug: String
  title: String
  description: String
  streamKey: String
  status: String
  createdAt: String
  updatedAt: String
}

type LiveStream {
  id: String
  roomId: String
  nodeId: String
  status: String
  startedAt: String
  endedAt: String
  peakViewer: Int
  createdAt: String
}

type LiveRecording {
  id: String
  streamId: String
  roomId: String
  objectKey: String
  durationSeconds: Int
  sizeBytes: Int
  createdAt: String
}

type LivePlaybackInfo {
  URL: String
  ExpiresAt: String
  IsLive: Boolean
}

input LiveCreateRoomInput {
  title: String
  description: String
}

extend type Query {
  liveRooms(live: Boolean): [LiveRoom!] @public @rest(service: "livestream-service", path: "/api/v1/rooms")
  liveRoom(id: String!): LiveRoom @public @rest(service: "livestream-service", path: "/api/v1/rooms/{id}")
  liveActiveStream(id: String!): LiveStream @public @rest(service: "livestream-service", path: "/api/v1/rooms/{id}/stream")
  liveRecordings(id: String!): [LiveRecording!] @public @rest(service: "livestream-service", path: "/api/v1/rooms/{id}/recordings")
  liveViewerCount(id: String!): LiveViewerCount @public @rest(service: "livestream-service", path: "/api/v1/rooms/{id}/viewers")
  livePlayback(id: String!): LivePlaybackInfo @public @rest(service: "livestream-service", path: "/api/v1/rooms/{id}/playback")
}

extend type Mutation {
  liveCreateRoom(input: LiveCreateRoomInput!): LiveRoom @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms")
  liveRegenerateStreamKey(id: String!): String @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/stream-key/regenerate", unwrap: "streamKey")
  liveRequestIngest(id: String!): Any @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/ingest")
  liveEndStream(id: String!): Boolean! @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/end")
  liveBanChat(id: String!, targetUserId: String!, durationSeconds: Int): Boolean! @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/chat/ban")
  liveUnbanChat(id: String!, targetUserId: String!): Boolean! @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/chat/unban")
  liveViewerHeartbeat(id: String!, sessionId: String!): Boolean! @public @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/viewers/heartbeat")
  liveReportQoE(id: String!, bitrateKbps: Float, bufferingEvents: Int): Boolean! @public @rest(service: "livestream-service", method: "POST", path: "/api/v1/rooms/{id}/qoe")
  liveAdminDeleteRoom(id: String!): Boolean! @hasPermission(object: "/graphql/livestream-service", action: "MUTATION") @rest(service: "livestream-service", method: "DELETE", path: "/api/v1/admin/rooms/{id}")
}
