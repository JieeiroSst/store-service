enum HospitalAppointmentStatus {
  APPOINTMENT_STATUS_UNSPECIFIED
  APPOINTMENT_STATUS_SCHEDULED
  APPOINTMENT_STATUS_COMPLETED
  APPOINTMENT_STATUS_CANCELLED
  APPOINTMENT_STATUS_NO_SHOW
}

enum HospitalBloodType {
  BLOOD_TYPE_UNSPECIFIED
  BLOOD_TYPE_A_POSITIVE
  BLOOD_TYPE_A_NEGATIVE
  BLOOD_TYPE_B_POSITIVE
  BLOOD_TYPE_B_NEGATIVE
  BLOOD_TYPE_AB_POSITIVE
  BLOOD_TYPE_AB_NEGATIVE
  BLOOD_TYPE_O_POSITIVE
  BLOOD_TYPE_O_NEGATIVE
}

enum HospitalGender {
  GENDER_UNSPECIFIED
  GENDER_MALE
  GENDER_FEMALE
  GENDER_OTHER
}

type HospitalAppointment {
  appointmentId: Int!
  patientId: Int!
  staffId: Int!
  departmentId: Int!
  appointmentDate: String
  status: HospitalAppointmentStatus
  reason: String!
  notes: String!
  createdAt: String
  updatedAt: String
}

type HospitalAppointmentStatsResponse {
  totalAppointments: Int!
  completedAppointments: Int!
  cancelledAppointments: Int!
  noShowAppointments: Int!
  dailyStats: [HospitalAppointmentStatsResponseDailyStats!]!
}

type HospitalAppointmentStatsResponseDailyStats {
  date: String!
  appointmentCount: Int!
}

type HospitalBilling {
  billId: Int!
  patientId: Int!
  appointmentId: Int!
  amount: Float
  insuranceCovered: Float
  patientResponsibility: Float
  status: String!
  dueDate: String!
  paidDate: String!
  createdAt: String
  updatedAt: String
}

type HospitalBillingStatsResponse {
  totalBilled: Float
  totalCollected: Float
  totalOutstanding: Float
  totalInsuranceCovered: Float
  totalPatientResponsibility: Float
  monthlyStats: [HospitalBillingStatsResponseMonthlyStats!]!
}

type HospitalBillingStatsResponseMonthlyStats {
  month: String!
  amountBilled: Float
  amountCollected: Float
}

type HospitalDepartment {
  departmentId: Int!
  name: String!
  description: String!
  createdAt: String
  updatedAt: String
}

type HospitalDepartmentStatsResponse {
  departmentStats: [HospitalDepartmentStatsResponseDepartmentStat!]!
}

type HospitalDepartmentStatsResponseDepartmentStat {
  departmentId: Int!
  departmentName: String!
  staffCount: Int!
  appointmentCount: Int!
}

type HospitalLabResult {
  resultId: Int!
  patientId: Int!
  orderedBy: Int!
  testName: String!
  testDate: String
  results: String!
  normalRange: String!
  notes: String!
  createdAt: String
  updatedAt: String
}

type HospitalListAppointmentsResponse {
  appointments: [HospitalAppointment!]!
  totalCount: Int!
}

type HospitalListBillingsResponse {
  billings: [HospitalBilling!]!
  totalCount: Int!
}

type HospitalListDepartmentsResponse {
  departments: [HospitalDepartment!]!
  totalCount: Int!
}

type HospitalListLabResultsResponse {
  labResults: [HospitalLabResult!]!
  totalCount: Int!
}

type HospitalListMedicalRecordsResponse {
  records: [HospitalMedicalRecord!]!
  totalCount: Int!
}

type HospitalListPatientsResponse {
  patients: [HospitalPatient!]!
  totalCount: Int!
}

type HospitalListPrescriptionsResponse {
  prescriptions: [HospitalPrescription!]!
  totalCount: Int!
}

type HospitalListStaffResponse {
  staff: [HospitalStaff!]!
  totalCount: Int!
}

type HospitalMedicalRecord {
  recordId: Int!
  patientId: Int!
  diagnosis: String!
  treatmentPlan: String!
  notes: String!
  createdBy: Int!
  createdAt: String
  updatedAt: String
}

type HospitalPatient {
  patientId: Int!
  firstName: String!
  lastName: String!
  dateOfBirth: String!
  gender: HospitalGender
  bloodType: HospitalBloodType
  address: String!
  phone: String!
  email: String!
  emergencyContactName: String!
  emergencyContactPhone: String!
  insuranceProvider: String!
  insurancePolicyNumber: String!
  createdAt: String
  updatedAt: String
}

type HospitalPrescription {
  prescriptionId: Int!
  patientId: Int!
  prescribedBy: Int!
  medicationName: String!
  dosage: String!
  frequency: String!
  startDate: String!
  endDate: String!
  instructions: String!
  createdAt: String
  updatedAt: String
}

type HospitalStaff {
  staffId: Int!
  departmentId: Int!
  firstName: String!
  lastName: String!
  role: String!
  specialization: String!
  email: String!
  phone: String!
  hireDate: String!
  licenseNumber: String!
  createdAt: String
  updatedAt: String
}

