extend type Query {
  hospitalGetDepartment(input: HospitalDepartmentInput!): HospitalDepartment @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListDepartments(input: HospitalListDepartmentsRequestInput!): HospitalListDepartmentsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetStaff(input: HospitalStaffInput!): HospitalStaff @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListStaff(input: HospitalListStaffRequestInput!): HospitalListStaffResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetPatient(input: HospitalPatientInput!): HospitalPatient @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListPatients(input: HospitalListPatientsRequestInput!): HospitalListPatientsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetMedicalRecord(input: HospitalMedicalRecordInput!): HospitalMedicalRecord @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListMedicalRecords(input: HospitalListMedicalRecordsRequestInput!): HospitalListMedicalRecordsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetAppointment(input: HospitalAppointmentInput!): HospitalAppointment @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListAppointments(input: HospitalListAppointmentsRequestInput!): HospitalListAppointmentsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetPrescription(input: HospitalPrescriptionInput!): HospitalPrescription @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListPrescriptions(input: HospitalListPrescriptionsRequestInput!): HospitalListPrescriptionsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetLabResult(input: HospitalLabResultInput!): HospitalLabResult @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListLabResults(input: HospitalListLabResultsRequestInput!): HospitalListLabResultsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetBilling(input: HospitalBillingInput!): HospitalBilling @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalListBillings(input: HospitalListBillingsRequestInput!): HospitalListBillingsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetDepartmentStats: HospitalDepartmentStatsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetAppointmentStats(input: HospitalAppointmentStatsRequestInput!): HospitalAppointmentStatsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
  hospitalGetBillingStats(input: HospitalBillingStatsRequestInput!): HospitalBillingStatsResponse @hasPermission(object: "/graphql/hospital", action: "QUERY")
}

