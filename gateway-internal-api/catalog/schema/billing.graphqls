type BillingAddress {
  address_id: Int!
  line1: String!
  line2: String!
  city: String!
  state: String!
  postal_code: String!
  country: String!
}

input BillingAddressInput {
  line1: String
  line2: String
  city: String
  state: String
  postal_code: String
  country: String
}

type BillingCustomer {
  customer_id: Int!
  name: String!
  company: String!
  email: String!
  phone_number: String!
  address_id: Int!
}

input BillingCustomerInput {
  name: String
  company: String
  email: String
  phone_number: String
  address_id: Int
}

type BillingPlan {
  plan_id: Int!
  name: String!
  description: String!
  price: Float!
  billing_cycle: String!
}

input BillingPlanInput {
  name: String
  description: String
  price: Float
  billing_cycle: String
}

type BillingSubscription {
  subscription_id: Int!
  customer_id: Int!
  plan_id: Int!
  start_date: Int!
  end_date: Int!
  status: String!
}

input BillingSubscriptionInput {
  customer_id: Int
  plan_id: Int
  start_date: Int
  end_date: Int
  status: String
}

type BillingInvoice {
  invoice_id: Int!
  subscription_id: Int!
  invoice_date: Int!
  due_date: Int!
  amount: Float!
  tax: String!
  status: String!
}

input BillingInvoiceInput {
  subscription_id: Int
  invoice_date: Int
  due_date: Int
  amount: Float
  tax: String
  status: String
}

type BillingTransaction {
  transaction_id: Int!
  invoice_id: Int!
  payment_method: String!
  transaction_date: Int!
  amount: Float!
  status: String!
}

input BillingTransactionInput {
  invoice_id: Int
  payment_method: String
  transaction_date: Int
  amount: Float
  status: String
}

extend type Query {
  billingAddresses: [BillingAddress!]! @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/addresses", unwrap: "data")
  billingAddress(id: Int!): BillingAddress @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/addresses/{id}", unwrap: "data")
  billingCustomers: [BillingCustomer!]! @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/customers", unwrap: "data")
  billingCustomer(id: Int!): BillingCustomer @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/customers/{id}", unwrap: "data")
  billingPlans: [BillingPlan!]! @public @rest(service: "billing-service", path: "/plans", unwrap: "data")
  billingPlan(id: Int!): BillingPlan @public @rest(service: "billing-service", path: "/plans/{id}", unwrap: "data")
  billingSubscriptions: [BillingSubscription!]! @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/subscriptions", unwrap: "data")
  billingSubscription(id: Int!): BillingSubscription @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/subscriptions/{id}", unwrap: "data")
  billingInvoices: [BillingInvoice!]! @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/invoices", unwrap: "data")
  billingInvoice(id: Int!): BillingInvoice @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/invoices/{id}", unwrap: "data")
  billingTransactions: [BillingTransaction!]! @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/transactions", unwrap: "data")
  billingTransaction(id: Int!): BillingTransaction @hasPermission(object: "/graphql/billing-service", action: "QUERY") @rest(service: "billing-service", path: "/transactions/{id}", unwrap: "data")
}

extend type Mutation {
  billingCreateAddress(input: BillingAddressInput!): BillingAddress @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "POST", path: "/addresses", unwrap: "data")
  billingUpdateAddress(id: Int!, input: BillingAddressInput!): BillingAddress @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "PUT", path: "/addresses/{id}", unwrap: "data")
  billingDeleteAddress(id: Int!): Boolean! @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "DELETE", path: "/addresses/{id}")
  billingCreateCustomer(input: BillingCustomerInput!): BillingCustomer @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "POST", path: "/customers", unwrap: "data")
  billingUpdateCustomer(id: Int!, input: BillingCustomerInput!): BillingCustomer @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "PUT", path: "/customers/{id}", unwrap: "data")
  billingDeleteCustomer(id: Int!): Boolean! @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "DELETE", path: "/customers/{id}")
  billingCreatePlan(input: BillingPlanInput!): BillingPlan @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "POST", path: "/plans", unwrap: "data")
  billingUpdatePlan(id: Int!, input: BillingPlanInput!): BillingPlan @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "PUT", path: "/plans/{id}", unwrap: "data")
  billingDeletePlan(id: Int!): Boolean! @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "DELETE", path: "/plans/{id}")
  billingCreateSubscription(input: BillingSubscriptionInput!): BillingSubscription @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "POST", path: "/subscriptions", unwrap: "data")
  billingUpdateSubscription(id: Int!, input: BillingSubscriptionInput!): BillingSubscription @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "PUT", path: "/subscriptions/{id}", unwrap: "data")
  billingDeleteSubscription(id: Int!): Boolean! @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "DELETE", path: "/subscriptions/{id}")
  billingCreateInvoice(input: BillingInvoiceInput!): BillingInvoice @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "POST", path: "/invoices", unwrap: "data")
  billingUpdateInvoice(id: Int!, input: BillingInvoiceInput!): BillingInvoice @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "PUT", path: "/invoices/{id}", unwrap: "data")
  billingDeleteInvoice(id: Int!): Boolean! @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "DELETE", path: "/invoices/{id}")
  billingCreateTransaction(input: BillingTransactionInput!): BillingTransaction @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "POST", path: "/transactions", unwrap: "data")
  billingUpdateTransaction(id: Int!, input: BillingTransactionInput!): BillingTransaction @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "PUT", path: "/transactions/{id}", unwrap: "data")
  billingDeleteTransaction(id: Int!): Boolean! @hasPermission(object: "/graphql/billing-service", action: "MUTATION") @rest(service: "billing-service", method: "DELETE", path: "/transactions/{id}")
}
