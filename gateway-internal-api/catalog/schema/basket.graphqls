type BasketBasket {
  id: Int!
  status: String!
  date_placed: String!
  date_created: String!
  date_merged: String!
  date_submitted: String!
  billing_address_id: Int!
  shipping_address_id: Int!
  user_id: Int!
  currency: String
  total_incl_tax: Float
  payment_reference: String
  fulfillment_id: String
}

type BasketLine {
  id: Int!
  line_reference: String!
  quantity: Int!
  price_currency: String!
  price_excl_tax: Float!
  price_incl_tax: Float!
  basket_id: Int!
  product_id: Int!
  stockrecord_id: Int!
}

type BasketLineAttribute {
  id: Int!
  basket_id: Int!
  line_id: Int!
  option_id: Int!
  value: String!
}

type BasketOrder {
  id: Int!
  number: String!
  currency: String!
  total_incl_tax: Float!
  total_excl_tax: Float!
  shipping_incl_tax: Float!
  shipping_excl_tax: Float!
  shipping_method: String!
  shipping_code: String!
  status: String!
  guest_email: String!
  site_id: Int!
  user_id: Int!
  owner_id: Int!
}

type BasketUser {
  id: String!
  username: String!
  email: String!
  name: String!
  active: Boolean!
}

input BasketBasketInput {
  status: String
  date_placed: String
  date_created: String
  date_merged: String
  date_submitted: String
  billing_address_id: Int
  shipping_address_id: Int
}

input BasketLineInput {
  line_reference: String
  quantity: Int
  price_currency: String
  price_excl_tax: Float
  price_incl_tax: Float
  basket_id: Int
  product_id: Int
  stockrecord_id: Int
}

input BasketLineAttributeInput {
  basket_id: Int
  line_id: Int
  option_id: Int
  value: String
}

extend type Query {
  basketBaskets: [BasketBasket!]! @rest(service: "basket-service", path: "/api/v1/baskets")
  basketBasket(id: Int!): BasketBasket @rest(service: "basket-service", path: "/api/v1/baskets/{id}")
  basketLines: [BasketLine!]! @rest(service: "basket-service", path: "/api/v1/basket-lines")
  basketLine(id: Int!): BasketLine @rest(service: "basket-service", path: "/api/v1/basket-lines/{id}")
  basketLineAttributes: [BasketLineAttribute!]! @rest(service: "basket-service", path: "/api/v1/basket-line-attributes")
  basketLineAttribute(id: Int!): BasketLineAttribute @rest(service: "basket-service", path: "/api/v1/basket-line-attributes/{id}")
  basketOrders: [BasketOrder!]! @rest(service: "basket-service", path: "/api/v1/orders")
  basketOrder(id: Int!): BasketOrder @rest(service: "basket-service", path: "/api/v1/orders/{id}")
  basketUser(id: Int!): BasketUser @rest(service: "basket-service", path: "/api/v1/users/{id}")
  basketBasketLines(id: Int!): [BasketLine!]! @rest(service: "basket-service", path: "/api/v1/baskets/{id}/lines")
}

extend type Mutation {
  basketCreateBasket(input: BasketBasketInput!): BasketBasket @rest(service: "basket-service", method: "POST", path: "/api/v1/baskets")
  basketUpdateBasket(id: Int!, input: BasketBasketInput!): BasketBasket @rest(service: "basket-service", method: "PUT", path: "/api/v1/baskets/{id}")
  basketDeleteBasket(id: Int!): Boolean! @rest(service: "basket-service", method: "DELETE", path: "/api/v1/baskets/{id}")
  basketCreateLine(input: BasketLineInput!): BasketLine @rest(service: "basket-service", method: "POST", path: "/api/v1/basket-lines")
  basketUpdateLine(id: Int!, input: BasketLineInput!): BasketLine @rest(service: "basket-service", method: "PUT", path: "/api/v1/basket-lines/{id}")
  basketDeleteLine(id: Int!): Boolean! @rest(service: "basket-service", method: "DELETE", path: "/api/v1/basket-lines/{id}")
  basketCreateLineAttribute(input: BasketLineAttributeInput!): BasketLineAttribute @rest(service: "basket-service", method: "POST", path: "/api/v1/basket-line-attributes")
  basketUpdateLineAttribute(id: Int!, input: BasketLineAttributeInput!): BasketLineAttribute @rest(service: "basket-service", method: "PUT", path: "/api/v1/basket-line-attributes/{id}")
  basketDeleteLineAttribute(id: Int!): Boolean! @rest(service: "basket-service", method: "DELETE", path: "/api/v1/basket-line-attributes/{id}")
  basketCheckout(id: Int!, wallet_id: String!, pin: String!, shipping_address_id: Int): BasketBasket @rest(service: "basket-service", method: "POST", path: "/api/v1/baskets/{id}/checkout")
}
