type ToolAndroidDevices {
  available: Boolean
  error: String
  devices: [ToolDevice!]
}

type ToolIosSimulators {
  available: Boolean
  error: String
  simulators: [ToolSimulator!]
}

type ToolMobileDevices {
  android: ToolAndroidDevices
  ios: ToolIosSimulators
}

type ToolSuiteResult {
  suite: ToolSuite
  precision: Float
}

type ToolJob {
  id: String
  kind: String
  status: String
  progress: String
  started_at: String
  finished_at: String
  result: Any
  error: String
}

type ToolDevice {
  serial: String
  state: String
  model: String
  product: String
  android_version: String
  sdk: Int
  screen: String
  density_dpi: Int
}

type ToolSimulator {
  udid: String
  name: String
  state: String
  runtime: String
}

type ToolStats {
  active_model: String
  base_model: String
  by_model: Map
  by_model_human_only: Map
  total: Int
  good: Int
  bad: Int
  pending: Int
  approval_rate: Float
  feedback_since_reflect: Int
  playbook: String
}

type ToolExperience {
  id: String
  kind: String
  input: String
  output: Any
  model: String
  verdict: String
  source: String
  score: Float
  note: String
  corrected: Any
  signals: Map
  embedding: [Float!]
  created_at: String
}

type ToolSnapshot {
  at: String
  model: String
  approval_rate: Float
  human_rate: Float
  auto_rate: Float
  reviews: Int
  by_model: Map
}

type ToolSuite {
  name: String
  cases: [ToolApproved!]
  ai_accepted: Int
  ai_rejected: Int
}

type ToolApproved {
  hash: String
  case: ToolTestCase
  approved_at: String
  from_ai: Boolean
}

type ToolTestCase {
  name: String
  method: String
  path: String
  headers: Map
  body: Any
  expect_status: Int
  expect_body_contains: [String!]
  expect_json: Map
  max_latency_ms: Int
  spec_quote: String
}

extend type Query {
  toolJobs: [ToolJob!] @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/jobs", unwrap: "jobs")
  toolJob(id: String!): ToolJob @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/jobs/{id}")
  toolMobileDevices: ToolMobileDevices @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/qa/mobile/devices")
  toolLearningStats: ToolStats @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/learning/stats")
  toolLearningPending: [ToolExperience!] @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/learning/pending", unwrap: "items")
  toolLearningHistory: [ToolSnapshot!] @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/learning/history", unwrap: "history")
  toolSuite(name: String!): ToolSuiteResult @hasPermission(object: "/graphql/tool-service", action: "QUERY") @rest(service: "tool-service", path: "/api/v1/suites/{name}")
}

extend type Mutation {
  toolGenerateTestCases(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/testcases/generate")
  toolRunTestCases(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/testcases/run")
  toolRunBenchmark(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/benchmark")
  toolAnalyzeCode(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/analyze/code")
  toolAnalyzeTask(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/tasks/analyze")
  toolQaScan(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/scan")
  toolExportXlsx(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/export/xlsx")
  toolQaDatabase(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/database")
  toolQaAsync(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/async")
  toolQaQueue(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/queue")
  toolQaBrowser(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/browser")
  toolQaActive(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/active")
  toolJobStress(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/jobs/stress")
  toolJobSoak(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/jobs/soak")
  toolMobileStatic(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/mobile/static")
  toolMobileAndroid(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/mobile/android")
  toolMobileIos(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qa/mobile/ios")
  toolQcRun(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/qc/run")
  toolLearningFeedback(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/learning/feedback")
  toolLearningReflect(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/learning/reflect")
  toolLearningEvolve(input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/learning/evolve")
  toolCancelJob(id: String!): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/jobs/{id}/cancel")
  toolApproveCases(name: String!, input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/suites/{name}/approve")
  toolRemoveCase(name: String!, hash: String!): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "DELETE", path: "/api/v1/suites/{name}/cases/{hash}")
  toolRunSuite(name: String!, input: Map): Any @hasPermission(object: "/graphql/tool-service", action: "MUTATION") @rest(service: "tool-service", method: "POST", path: "/api/v1/suites/{name}/run")
}
