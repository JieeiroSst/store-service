}

input ResvTierInput {
  hours_before: Int
  fee_percent: Float
}

input ResvHotelInput {
  name: String
  description: String
  stars: Int
  city: String
  address: String
  phone_number: String
  email: String
  images: [String!]
  amenities: [String!]
  check_in_time: String
  check_out_time: String
  currency: String
  free_cancel_hours: Int
  cancellation_tiers: [Map!]
  wallet_id: String
  status: Int
}

input ResvRoomTypeInput {
  name: String
  description: String
  capacity: Int
  bed: String
  size_m2: Int
  view: String
  amenities: [String!]
  active: Boolean
}

input ResvRoomInput {
  room_type_id: Int64
  name: String
  floor: Int
  available: Boolean
}

input ResvInventoryInput {
  from: String
  to: String
  total_inventory: Int
  rate: Float
  rate_off: Boolean
}

input ResvServiceInput {
  name: String
  description: String
  price: Float
  unit: String
  active: Boolean
}

input ResvAddonInput {
  service_id: Int64
  quantity: Int
}

input ResvReservationInput {
  hotel_id: Int64
  room_type_id: Int64
  check_in: String
  check_out: String
  rooms: Int
  adults: Int
  children: Int
  special_requests: String
  services: [ResvAddonInput!]
  promo_code: String
  request_id: String
}

extend type Query {
  resvHotels(city: String, q: String, rooms: Int, guests: Int, sort: String, limit: Int, min_rate: String, max_rate: String, amenities: String, cursor: String, check_in: String, check_out: String): ResvHotelPage @public @rest(service: "reservation-service", path: "/api/v1/hotels")
  resvHotel(id: Int!): ResvHotel @public @rest(service: "reservation-service", path: "/api/v1/hotels/{id}")
  resvRoomTypes(id: Int!): [ResvRoomType!] @public @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/room-types")
  resvInventory(id: Int!, type: Int!, from: String, to: String): [ResvInventory!] @public @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/room-types/{type}/inventory")
  resvQuotes(id: Int!, check_in: String!, check_out: String!, rooms: Int): [ResvQuote!] @public @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/quotes")
  resvServices(id: Int!): [ResvService!] @public @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/services")
  resvReviews(id: Int!, cursor: String, limit: Int): ResvReviewPage @public @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/reviews")
  resvMyHotels(limit: Int): ResvHotelPage @rest(service: "reservation-service", path: "/api/v1/my/hotels")
  resvHotelReviewQueue(status: String, limit: Int): ResvHotelPage @rest(service: "reservation-service", path: "/api/v1/admin/hotels")
  resvRooms(id: Int!, room_type_id: Int): [ResvRoom!] @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/rooms")
  resvPromotions(id: Int!): [ResvPromotion!] @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/promotions")
  resvHotelReport(id: Int!, from: String, to: String): ResvReport @rest(service: "reservation-service", path: "/api/v1/hotels/{id}/report")
  resvReservations(status: String, cursor: String, as: String, hotel_id: Int, limit: Int): ResvReservationPage @rest(service: "reservation-service", path: "/api/v1/reservations")
  resvReservation(id: Int!): ResvReservation @rest(service: "reservation-service", path: "/api/v1/reservations/{id}")
  resvCancellationQuote(id: Int!): ResvCancellationQuote @rest(service: "reservation-service", path: "/api/v1/reservations/{id}/cancellation-quote")
  resvReservationHistory(id: Int!): [ResvHistoryEntry!] @rest(service: "reservation-service", path: "/api/v1/reservations/{id}/history")
  resvWaitlist(cursor: String, limit: Int): ResvWaitPage @rest(service: "reservation-service", path: "/api/v1/waitlist")
  resvWishlist(cursor: String, limit: Int): ResvHotelPage @rest(service: "reservation-service", path: "/api/v1/wishlist")
  resvNotifications(cursor: String, unread: Boolean, limit: Int): ResvNotificationPage @rest(service: "reservation-service", path: "/api/v1/notifications")
  resvUnreadNotifications: ResvUnreadCount @rest(service: "reservation-service", path: "/api/v1/notifications/unread-count")
  resvLoyalty: ResvLoyalty @rest(service: "reservation-service", path: "/api/v1/loyalty")
  resvWallet: ResvWallet @rest(service: "reservation-service", path: "/api/v1/wallet")
  resvWalletTransactions(limit: Int, offset: Int): [ResvWalletTxn!] @rest(service: "reservation-service", path: "/api/v1/wallet/transactions")
}

extend type Mutation {
  resvRegisterHotel(input: ResvHotelInput!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/hotels")
  resvApproveHotel(id: Int!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/hotels/{id}/approve")
  resvRejectHotel(id: Int!, reason: String!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/hotels/{id}/reject")
  resvUpdateHotel(id: Int!, input: ResvHotelInput!): Any @rest(service: "reservation-service", method: "PUT", path: "/api/v1/hotels/{id}")
  resvDeactivateHotel(id: Int!): Boolean! @rest(service: "reservation-service", method: "DELETE", path: "/api/v1/hotels/{id}")
