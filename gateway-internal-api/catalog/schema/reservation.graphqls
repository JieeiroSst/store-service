type ResvUnreadCount {
  unread: Int
}

type ResvReviewPage {
  items: [ResvReview!]
  has_more: Boolean
  next_cursor: String
}

type ResvReservationPage {
  items: [ResvReservation!]
  has_more: Boolean
  next_cursor: String
}

type ResvWaitPage {
  items: [ResvWait!]
  has_more: Boolean
  next_cursor: String
}

type ResvNotificationPage {
  items: [ResvNotification!]
  has_more: Boolean
  next_cursor: String
}

type ResvHotel {
  id: Int
  name: String
  description: String
  stars: Int
  city: String
  address: String
  phone_number: String
  email: String
  images: [String!]
  amenities: [String!]
  check_in_time: String
  check_out_time: String
  currency: String
  free_cancel_hours: Int
  cancellation_policy: [ResvtierDTO!]
  status: Int
  status_name: String
  review_note: String
  manager_id: Int
  accepts_wallet_payment: Boolean
  rating: Float
  review_count: Int
  room_types: [ResvRoomType!]
  created_at: String
}

type ResvHotelPage {
  items: [ResvHotel!]
  has_more: Boolean
  next_cursor: String
}

type ResvRoomType {
  id: Int
  name: String
  description: String
  capacity: Int
  bed: String
  size_m2: Int
  view: String
  amenities: [String!]
  active: Boolean
}

type ResvRoom {
  id: Int
  room_type_id: Int
  name: String
  floor: Int
  available: Boolean
}

type ResvInventory {
  date: String
  total_inventory: Int
  total_reserved: Int
  left: Int
  rate: String
}

type ResvQuote {
  room_type: ResvRoomType
  nights: Int
  rooms_available: Int
  total: String
  bookable: Boolean
}

type ResvService {
  id: Int
  name: String
  description: String
  price: String
  unit: String
  active: Boolean
}

type ResvReservation {
  id: Int
  hotel_id: Int
  room_type_id: Int
  guest_id: Int
  check_in: String
  check_out: String
  nights: Int
  rooms: Int
  adults: Int
  children: Int
  status: Int
  status_name: String
  status_note: String
  currency: String
  room_total: String
  promo_code: String
  discount: String
  services_total: String
  total_amount: String
  cancellation_fee: String
  refund_amount: String
  stay_status: String
  checked_in_at: String
  checked_out_at: String
  special_requests: String
  services: [ResvAddon!]
  request_id: String
  payment_method: String
  payment_ref: String
