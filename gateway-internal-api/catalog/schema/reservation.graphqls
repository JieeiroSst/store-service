  resvCreatePromotion(id: Int!, input: Map!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/hotels/{id}/promotions")
  resvUpdatePromotion(id: Int!, promo: String!, input: Map!): Any @rest(service: "reservation-service", method: "PUT", path: "/api/v1/hotels/{id}/promotions/{promo}")
  resvCreateService(id: Int!, input: ResvServiceInput!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/hotels/{id}/services")
  resvUpdateService(id: Int!, service: String!, input: ResvServiceInput!): Any @rest(service: "reservation-service", method: "PUT", path: "/api/v1/hotels/{id}/services/{service}")
  resvReserve(input: ResvReservationInput!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/reservations")
  resvPayReservation(id: Int!, method: String!, provider: String): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/reservations/{id}/pay")
  resvCancelReservation(id: Int!, reason: String): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/reservations/{id}/cancel")
  resvRejectReservation(id: Int!, reason: String): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/reservations/{id}/reject")
