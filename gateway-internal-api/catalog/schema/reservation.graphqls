  resvCheckOutReservation(id: Int!, reason: String): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/reservations/{id}/check-out")
  resvNoShowReservation(id: Int!, reason: String): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/reservations/{id}/no-show")
  resvCreateReview(id: Int!, input: Map!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/hotels/{id}/reviews")
  resvJoinWaitlist(input: Map!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/waitlist")
  resvLeaveWaitlist(id: Int!): Boolean! @rest(service: "reservation-service", method: "DELETE", path: "/api/v1/waitlist/{id}")
  resvAddFavourite(id: Int!): Boolean! @rest(service: "reservation-service", method: "PUT", path: "/api/v1/wishlist/{id}")
  resvRemoveFavourite(id: Int!): Boolean! @rest(service: "reservation-service", method: "DELETE", path: "/api/v1/wishlist/{id}")
  resvMarkAllNotificationsRead: Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/notifications/read-all")
  resvMarkNotificationRead(id: Int!): Any @rest(service: "reservation-service", method: "POST", path: "/api/v1/notifications/{id}/read")
