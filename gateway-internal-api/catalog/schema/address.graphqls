extend type Query {
  addressCountries: [AddressCountry!]! @public @rest(service: "address-country", path: "/address-countries", unwrap: "data")
  addressCountry(id: Int!): AddressCountry @public @rest(service: "address-country", path: "/address-countries/{id}", unwrap: "data")
  addressOrderBillingAddresses: [AddressOrderBillingAddress!]! @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/order-billing-addresses", unwrap: "data")
  addressOrderBillingAddress(id: Int!): AddressOrderBillingAddress @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/order-billing-addresses/{id}", unwrap: "data")
  addressOrderShippingAddresses: [AddressOrderShippingAddress!]! @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/order-shipping-addresses", unwrap: "data")
  addressOrderShippingAddress(id: Int!): AddressOrderShippingAddress @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/order-shipping-addresses/{id}", unwrap: "data")
  addressPartnerAddresses: [AddressPartnerAddress!]! @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/partner-addresses", unwrap: "data")
  addressPartnerAddress(id: Int!): AddressPartnerAddress @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/partner-addresses/{id}", unwrap: "data")
  addressShippingOrderAndItemChangesCountries: [AddressShippingOrderAndItemChangesCountry!]! @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/shipping-orderanditemchanges-countries", unwrap: "data")
  addressShippingOrderAndItemChangesCountry(id: Int!): AddressShippingOrderAndItemChangesCountry @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/shipping-orderanditemchanges-countries/{id}", unwrap: "data")
  addressShippingWeightBasedCountries: [AddressShippingWeightBasedCountry!]! @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/shipping-weightbased-countries", unwrap: "data")
  addressShippingWeightBasedCountry(id: Int!): AddressShippingWeightBasedCountry @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/shipping-weightbased-countries/{id}", unwrap: "data")
  addressUserAddresses: [AddressUserAddress!]! @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/user-addresses", unwrap: "data")
  addressUserAddress(id: Int!): AddressUserAddress @hasPermission(object: "/graphql/address-country", action: "QUERY") @rest(service: "address-country", path: "/user-addresses/{id}", unwrap: "data")
  myUserAddresses: [AddressUserAddress!]!
}

