  addressCreatePartnerAddress(input: AddressPartnerAddressInput!): AddressPartnerAddress @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "POST", path: "/partner-addresses", unwrap: "data")
