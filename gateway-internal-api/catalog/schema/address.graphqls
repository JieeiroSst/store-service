  addressCreateCountry(input: AddressCountryInput!): AddressCountry @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "POST", path: "/address-countries", unwrap: "data")
  addressUpdateCountry(id: Int!, input: AddressCountryInput!): AddressCountry @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "PUT", path: "/address-countries/{id}", unwrap: "data")
  addressDeleteCountry(id: Int!): Boolean! @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "DELETE", path: "/address-countries/{id}")
