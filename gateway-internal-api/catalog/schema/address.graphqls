type AddressCountry {
  iso31661a2: String!
  prinatable_name: String!
  name: String!
  display_order: Int!
  is_shipping_country: Boolean!
}

type AddressOrderBillingAddress {
  id: Int!
  title: String!
  first_name: String!
  last_name: String!
  line1: String!
  line2: String!
  line3: String!
  line4: String!
  state: String!
  postcode: String!
  search_text: String!
  country_id: String!
  address_country: AddressCountry
}

