  addressDeletePartnerAddress(id: Int!): Boolean! @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "DELETE", path: "/partner-addresses/{id}")
  addressCreateShippingOrderAndItemChangesCountry(input: AddressShippingOrderAndItemChangesCountryInput!): AddressShippingOrderAndItemChangesCountry @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "POST", path: "/shipping-orderanditemchanges-countries", unwrap: "data")
  addressUpdateShippingOrderAndItemChangesCountry(id: Int!, input: AddressShippingOrderAndItemChangesCountryInput!): AddressShippingOrderAndItemChangesCountry @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "PUT", path: "/shipping-orderanditemchanges-countries/{id}", unwrap: "data")
  addressDeleteShippingOrderAndItemChangesCountry(id: Int!): Boolean! @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "DELETE", path: "/shipping-orderanditemchanges-countries/{id}")
  addressCreateShippingWeightBasedCountry(input: AddressShippingWeightBasedCountryInput!): AddressShippingWeightBasedCountry @hasPermission(object: "/graphql/address-country", action: "MUTATION") @rest(service: "address-country", method: "POST", path: "/shipping-weightbased-countries", unwrap: "data")
