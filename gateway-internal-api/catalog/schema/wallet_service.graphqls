type WalletSvcWallet {
  id: String
  user_id: String
  balance: String
  frozen_amount: String
  currency: String
  status: String
  version: Int
  created_at: String
  updated_at: String
}

type WalletSvcTransaction {
  id: String
  idempotency_key: String
  wallet_id: String
  merchant_id: String
  acquirer_bank_id: String
  issuer_bank_id: String
  card_id: String
  card_network: String
  amount: String
  currency: String
  fee: String
  type: String
  status: String
  description: String
  authorization_code: String
  batch_id: String
  metadata: Map
  created_at: String
  updated_at: String
}

extend type Query {
  walletSvcWallet(id: String!): WalletSvcWallet @hasPermission(object: "/graphql/wallet-service", action: "QUERY") @rest(service: "wallet-service", path: "/api/v1/wallets/{id}")
  walletSvcTransaction(id: String!): WalletSvcTransaction @hasPermission(object: "/graphql/wallet-service", action: "QUERY") @rest(service: "wallet-service", path: "/api/v1/transactions/{id}")
}

extend type Mutation {
  walletSvcCreateWallet(user_id: String!, currency: String!): WalletSvcWallet @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/wallets")
  walletSvcCredit(id: String!, amount: String!, description: String): Any @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/wallets/{id}/credit")
  walletSvcFreeze(id: String!): Any @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/wallets/{id}/freeze")
  walletSvcAuthorize(idempotency_key: String!, card_id: String!, merchant_id: String!, amount: String!, currency: String!, description: String, metadata: Map): WalletSvcTransaction @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/transactions/authorize", headerArgs: "idempotency_key:Idempotency-Key")
  walletSvcCapture(id: String!): WalletSvcTransaction @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/transactions/{id}/capture")
  walletSvcVoid(id: String!): WalletSvcTransaction @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/transactions/{id}/void")
  walletSvcCreateSettlementBatch(merchant_id: String!): Any @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/settlements/batches")
  walletSvcProcessClearing(batch_id: String!): Any @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/settlements/batches/{batch_id}/clear")
  walletSvcProcessSettlement(batch_id: String!): Any @hasPermission(object: "/graphql/wallet-service", action: "MUTATION") @rest(service: "wallet-service", method: "POST", path: "/api/v1/settlements/batches/{batch_id}/settle")
}
