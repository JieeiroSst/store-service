type PayerTransactionResponse {
  transaction: PayerTransactions
  payers: PayerPayers
  buyers: PayerBuyers
}

type PayerTransactions {
  transaction_id: Int
  payer_id: Int
  buyer_id: Int
  amount: Float
  transaction_date: String
  transaction_type: Int
  description: String
  status: Int
}

type PayerPayers {
  payer_id: Int
  name: String
  email: String
  phone_number: String
}

type PayerBuyers {
  buyer_id: Int
  name: String
  email: String
  phone_number: String
}

extend type Query {
  payerTransaction(transaction_id: Int!): PayerTransactionResponse @hasPermission(object: "/graphql/payer-service", action: "QUERY") @rest(service: "payer-service", path: "/api/v1/transaction", unwrap: "data")
}
