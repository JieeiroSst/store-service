# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=call_center_db
# DATABASE_URL=sqlite:///local.db  # ghi đè DB_* nếu đặt

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
PUBLIC_BASE_URL=https://your-domain.ngrok.io

# Admin API authentication
USER_SERVICE_URL=http://user-api-svc
INTERNAL_API_TOKENS=change-me

# AI Configuration (Claude là provider chính, OpenAI là dự phòng)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_REFUSAL_FALLBACK=true
OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4-turbo-preview
LLM_TIMEOUT_SECONDS=10

# Kịch bản tổng đài
VOICE_SCENARIO=customer_support
VOICE_MAX_TURNS=20
KNOWLEDGE_TOP_K=3
# Số tổng đài viên để chuyển máy; để trống thì bot ghi nhận yêu cầu gọi lại
AGENT_PHONE_NUMBER=
COMPANY_NAME=Store Service
COMPANY_HOTLINE_HOURS=8:00 - 21:00 tất cả các ngày trong tuần
COMPANY_WEBSITE=
COMPANY_INFO=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# TTS Configuration (Choose one or more)
# Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
GOOGLE_TTS_ENABLED=true

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id

VOICE_LANGUAGE=vi-VN
