APP_NAME=lottery-service
LOG_LEVEL=INFO

MONGO_URI=mongodb://mongo-svc:80
MONGO_DB=lottery

HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=2
HTTP_DELAY_BETWEEN_REQUESTS_SECONDS=1.5
SCRAPER_SOURCE_NAME=minhchinh.com
SCRAPER_BASE_URL=https://www.minhchinh.com

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
SCHEDULER_RUN_HOURS=[18,19,21]
SCHEDULER_RUN_MINUTE=30

ENABLE_KHUYEN_KHICH_RULE=true

BACKFILL_DELAY_SECONDS=1.0
