{
    "server": {
        "portHttpServer": "8080"
    },
    "postgres": {
        "postgresqlHost": "postgresdb",
        "postgresqlPort": "80",
        "postgresqlUser": "testUser",
        "postgresqlPassword": "testPassword",
        "postgresqlDbname": "livestream",
        "postgresqlSSLMode": false
    },
    "redis": {
        "addr": "redis:6379",
        "password": "",
