PORT=8080
# When set, /api/v1 requests must send it as the X-API-Key header
API_KEY=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DBNAME=customer_relationship_service

# Cron spec of the job that closes contracts past their end date ("off" disables)
CONTRACT_EXPIRY_CRON=0 * * * *

# Digital signatures on contract renewal: PEM bundle of trusted CA certificates.
# Without it every signature is refused, unless SIGNATURE_ALLOW_UNTRUSTED=true (development only).
SIGNATURE_TRUST_ROOTS_FILE=
SIGNATURE_ALLOW_UNTRUSTED=
# hard (default): OCSP/CRL must confirm the chain is unrevoked; soft: only "revoked" refuses; off
SIGNATURE_REVOCATION=hard
SIGNATURE_HTTP_TIMEOUT=10s
# RFC 3161 time-stamp authority; when set, detached signatures are time-stamped and a failure refuses the renewal
SIGNATURE_TSA_URL=
# PEM bundle for the authority's CA; defaults to SIGNATURE_TRUST_ROOTS_FILE
SIGNATURE_TSA_ROOTS_FILE=

# Authentication: API key (a service caller) and/or OIDC bearer tokens (people).
# Roles in the token: <prefix>viewer, staff, manager, admin. With neither set the API is open.
API_KEY_ROLE=admin
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=realm_access.roles
ROLE_PREFIX=crm-

# Virus scanning of uploads (ClamAV daemon host:port; empty = off), and active-content checks of PDFs
CLAMAV_ADDRESS=
CLAMAV_REQUIRED=true
CLAMAV_TIMEOUT=30s
PDF_POLICY=strict

# Largest contract file a user may upload, in MB
CONTRACT_FILE_MAX_MB=25

# MinIO / S3 bucket for signed contract PDFs. Empty endpoint keeps them in the database.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=customer-relationship-service
MINIO_USE_SSL=false

# Temporal: a durable lifecycle workflow per contract (expiry timer, reminders). Empty address = off.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=crm-contract-lifecycle
TEMPORAL_REMINDER_DAYS=30,7,1

# "Bên A" on generated contract documents
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_CODE=
COMPANY_PHONE=
COMPANY_REPRESENTATIVE=
COMPANY_REPRESENTATIVE_TITLE=
COMPANY_PLACE=
# Bên A's digital signature (PEM key without passphrase, certificate chain leaf first).
# When set, renewals are countersigned after Bên B signs.
COMPANY_SIGN_KEY_FILE=
COMPANY_SIGN_CERT_FILE=

# notification_service API (leave empty to disable notifications)
NOTIFICATION_SERVICE_URL=http://localhost:1235
NOTIFICATION_TYPE=slack
NOTIFICATION_RECIPIENT=
NOTIFICATION_TIMEOUT=3s
